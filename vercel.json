{
  "regions": ["icn1"],
  "functions": {
    "src/app/api/quotes/**": {
      "memory": 1600,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/wfm/cron/retention",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/webhooks/cron",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/wfm/cron/hours-alert",
      "schedule": "*/15 * * * *"
    }
  ]
}
