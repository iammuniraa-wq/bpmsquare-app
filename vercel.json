{
  "regions": ["icn1"],
  "functions": {
    "src/app/api/quotes/**": {
      "memory": 1600,
      "maxDuration": 60
    },
    "src/app/api/wfm/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/wfm/cron/retention",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/webhooks/cron",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/wfm/cron/hours-alert",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/pricing/cron/retention",
      "schedule": "15 20 * * *"
    },
    {
      "path": "/api/wfm/cron/project-invoices",
      "schedule": "30 0 1 * *"
    },
    {
      "path": "/api/wfm/cron/saturday-roster",
      "schedule": "0 3 25 * *"
    },
    {
      "path": "/api/wfm/cron/holiday-week",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/rfqs/cron/mailbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/rfqs/cron/reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/connectors/cron/dynamics365",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/connectors/cron/sap_s4",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/marketing/cron/journeys",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/marketing/cron/attribution",
      "schedule": "5 */3 * * *"
    },
    {
      "path": "/api/events/cron/invoice-overdue",
      "schedule": "45 20 * * *"
    },
    {
      "path": "/api/events/cron/score-leads",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/signals/cron/rescore",
      "schedule": "20 */3 * * *"
    },
    {
      "path": "/api/middleware/cron/prune",
      "schedule": "50 * * * *"
    }
  ]
}
