{
  "regions": ["icn1"],
  "functions": {
    "src/app/api/quotes/**": {
      "memory": 1600,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/wfm/cron/retention",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/webhooks/cron",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/wfm/cron/hours-alert",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/pricing/cron/retention",
      "schedule": "15 20 * * *"
    },
    {
      "path": "/api/wfm/cron/project-invoices",
      "schedule": "30 0 1 * *"
    },
    {
      "path": "/api/wfm/cron/saturday-roster",
      "schedule": "0 3 25 * *"
    },
    {
      "path": "/api/wfm/cron/holiday-week",
      "schedule": "0 3 * * 1"
    }
  ]
}
